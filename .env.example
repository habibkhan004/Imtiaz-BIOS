# Auth / session
AUTH_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
BCRYPT_ROUNDS=10

# Trial / intro access (FR-11)
INTRO_ENABLED=true
INTRO_DURATION_DAYS=183

# File storage (demo local adapter; swap to S3 later)
FILE_STORAGE_ROOT=.data/objects
MAX_UPLOAD_BYTES=52428800
DATA_DB_PATH=.data/imtiaz-db.json

# Future MongoDB — set in .env.local (never commit real credentials)
# Example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/imtiaz_bios?retryWrites=true&w=majority
MONGODB_URI=

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Phase 2 / 3 feature flags (default off)
FEATURE_LIVE_PAYMENTS=false
FEATURE_MALWARE_SCAN=false
FEATURE_AI_CLASSIFICATION=false
FEATURE_DUPLICATE_DETECTION=false

# Seeded demo accounts (created on first boot)
# admin@imtiazbios.local / Admin123!
# tech@imtiazbios.local / Tech123!
# user@imtiazbios.local / User123!

# Public app URL (used in password-reset emails)
APP_URL=http://localhost:3000

# Gmail SMTP (use a Google App Password — never commit real values)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional absolute logo for emails (default: inline IB chip)
EMAIL_LOGO_URL=
